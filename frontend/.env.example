# Скопируйте в .env и заполните. .env не коммитится.
PORT=3001
HOST=127.0.0.1
DATABASE_PATH=./data/ai-sana.db
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
OPENAI_API_KEY=
OPENAI_MODEL=
# auto — модель при наличии ключа, иначе локальные вопросы; stub — всегда локальные; openai — только модель (с откатом на stub при ошибке)
AI_MODE=auto
AI_TIMEOUT_MS=30000
AI_MAX_OUTPUT_TOKENS=4096
SESSION_TTL_HOURS=24
# Путь к собранному фронтенду относительно рабочей папки сервера (пусто — ./dist, если есть)
FRONTEND_DIST=
GIT_MODE=real
GITHUB_TOKEN=
GIT_TIMEOUT_MS=15000
